__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ocm-mcp/
# real kubeconfig files only (not docs about kubeconfig)
/kubeconfig
*.kubeconfig
!examples/kubeconfig.example
# Raw eval runs are scratch: run_eval.py writes one per invocation and most are
# discarded. A run worth citing is promoted by eval/promote.py, which stamps the
# server version/commit/tool-count onto it and writes it to
# eval/results/published/ - not matched here, because a gitignore `*` never
# crosses a `/`.
eval/results/*.json
# Per-agent server state for eval runs (audit chain, keys). Scratch, and one
# `git add -A` away from committing an audit log.
.eval-*-home/
.DS_Store
# local end-to-end test output (generated by hack/e2e-local.sh) - never checked in
/e2e-report.html
/.e2e-run/

# coverage artifacts
.coverage
htmlcov/

# unit-test report artifacts (generated by make test-report) - never checked in
/.unit-report/

# Generated documentation site (hack/build_site.py)
_site/

# Local browser-automation scratch
.playwright-mcp/
shot-*.png
