[0.001, "o", "\r\n\u001b[1;36m# 2. point it at the fleet: hub context, read-only spoke contexts, a state dir\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m$ export OCM_MCP_HUB_CONTEXT=kind-hub\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m$ export OCM_MCP_SPOKE_CONTEXTS=cluster1=kind-cluster1,cluster2=kind-cluster2,cluster3=kind-cluster3\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m$ export OCM_MCP_HOME=$PWD/state\u001b[0m\r\n"]
