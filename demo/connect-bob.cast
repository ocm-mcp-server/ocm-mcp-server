[0.027, "o", "\r\n\u001b[1;36m# 1. install the MCP server from PyPI\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m$ rm -rf '/Users/sandeepbazar/01.Projects/SandeepBazar/ocm-mcp-server/.demo-connect' && mkdir -p '/Users/sandeepbazar/01.Projects/SandeepBazar/ocm-mcp-server/.demo-connect' && cd '/Users/sandeepbazar/01.Projects/SandeepBazar/ocm-mcp-server/.demo-connect'\u001b[0m\r\n"]
[0.561, "o", "\u001b[0;90m$ python3 -m venv ocm && source ocm/bin/activate\u001b[0m\r\n"]
[1.340, "o", "\u001b[0;90m$ pip install -q ocm-mcp-server && which ocm-mcp-server\u001b[0m\r\n"]
[5.684, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m25.2\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.2.1\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
