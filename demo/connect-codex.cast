[0.000, "o", "g=created, placement=created\\r\\n\"]\r\n../demo/e2e-local.cast:63:[0.000, \"o\", \"           \\\"available\\\": 2,\\r\\n           \\\"total\\\": 2\\r\\n         },\\r\\n         \\\"conditions\\\": {\\r\\n           \\\"PlacementVerified\\\": \\\"True\\\",\\r\\n           \\\"PlacementRolledOut\\\": \\\"False\\\",\\r\\n\"]\r\n../demo/e2e-local.cast:93:[0.002, \"o\", \"\\r\\n\\u001b[1;32m[OK]\\u001b[0m \\u001b[1;36mlist_placements\\u001b[0m\\r\\n   \\u001b[0;90mPlacements and how many clusters each selects.\\u001b[0m\\r\\n   \\u001b[0;90m$ tool: list_placements\\u001b[0m\\r\\n     [\\r\\n\"]\r\n../demo/e2e-local.cast:94:[0.000, \"o\", \"       {\\r\\n         \\\"namespace\\\": \\\"default\\\",\\r\\n         \\\"name\\\": \\\"demo-all\\\",\\r\\n         \\\"cluster_sets\\\": [\\r\\n\"]\r\n../demo/e2e-local.cast:100:[0.000, \"o\", \"           \\\"PlacementMisconfigured\\\": \\\"False\\\",\\r\\n\"]\r\n../demo/e2e-local.cast:101:[0.000, \"o\", \"           \\\"PlacementSatisfied\\\": \\\"True\\\"\\r\\n\"]\r\n../demo/e2e-local.cast:102:[0.001, \"o\", \"\\r\\n\\u001b[1;32m[OK]\\u001b[0m \\u001b[1;36mget_placement_decision(demo-all)\\u001b[0m\\r\\n   \\u001b[0;9"]
