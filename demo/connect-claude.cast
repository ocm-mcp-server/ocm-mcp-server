[0.140, "o", "\r\n\u001b[1;36m# 1. install the MCP server from PyPI\u001b[0m\r\n\u001b[0;90m$ rm -rf '/Users/sandeepbazar/01.Projects/SandeepBazar/ocm-mcp-server/.demo-connect' && mkdir -p '/Users/sandeepbazar/01.Projects/SandeepBazar/ocm-mcp-server/.demo-connect' && cd '/Users/sandeepbazar/01.Projects/SandeepBazar/ocm-mcp-server/.demo-connect'\u001b[0m\r\n"]
