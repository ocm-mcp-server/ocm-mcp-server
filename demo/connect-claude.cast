[0.676, "o", "id:       4009080c0cdd48dea497a25ba6a1f899\r\ncluster:  cluster2\r\nname:     storefront\r\nstatus:   pending\r\nsummary:  Deploy 'storefront' Deployment in namespace 'shop' on cluster2: 2 replicas of pinned image nginx:1.27.1, hardened non-privileged pod spec (runAsNonRoot, no privilege escalation, all capabilities dropped, RuntimeDefault seccomp, no service account token). No other resources.\r\nmanifests:\r\n"]
[0.000, "o", "[\r\n  {\r\n    \"apiVersion\": \"apps/v1\",\r\n    \"kind\": \"Deployment\",\r\n    \"metadata\": {\r\n      \"labels\": {\r\n        \"app\": \"storefront\"\r\n      },\r\n      \"name\": \"storefront\",\r\n      \"namespace\": \"shop\"\r\n    },\r\n    \"spec\": {\r\n      \"replicas\": 2,\r\n      \"selector\": {\r\n        \"matchLabels\": {\r\n          \"app\": \"storefront\"\r\n        }\r\n      },\r\n      \"template\": {\r\n        \"metadata\": {\r\n          \"labels\": {\r\n            \"app\": \"storefront\"\r\n          }\r\n        },\r\n        \"spec\": {\r\n          \"automountServiceAccountToken\": false,\r\n          \"containers\": [\r\n            {\r\n              \"image\": \"nginx:1.27.1\",\r\n              \"name\": \"nginx\",\r\n              \"ports\": [\r\n                {\r\n                  \"containerPort\": 80\r\n                }\r\n              ],\r\n              \"securityContext\": {\r\n                \"allowPrivilegeEscalation\": false,\r\n                \"capabilities\": {\r\n                  \"drop\": [\r\n                    \"ALL\"\r\n                  ]\r\n                },\r\n                \"privileged\": fal"]
[0.000, "o", "se,\r\n                \"runAsNonRoot\": true,\r\n                \"seccompProfile\": {\r\n                  \"type\": \"RuntimeDefault\"\r\n                }\r\n              }\r\n            }\r\n          ],\r\n          \"securityContext\": {\r\n            \"runAsNonRoot\": true,\r\n            \"seccompProfile\": {\r\n              \"type\": \"RuntimeDefault\"\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n]\r\n"]
