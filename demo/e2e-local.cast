[0.000, "o", "         \"install_strategy\": \"Manual\",\r\n"]
[0.000, "o", "         \"conditions\": {}\r\n       }\r\n     ]\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mget_addon_health\u001b[0m\r\n   \u001b[0;90mPer-cluster add-on health across the fleet.\u001b[0m\r\n"]
