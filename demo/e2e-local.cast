[0.050, "o", "\r\n\u001b[1;36m========== 1. Dependencies - install if missing, otherwise show the installed version ==========\u001b[0m\r\n"]
[0.022, "o", "\u001b[1;32m  ✓ podman already installed - podman version 6.0.2\u001b[0m\r\n"]
[0.048, "o", "\u001b[1;32m  ✓ kind already installed - kind v0.32.0 go1.26.3 darwin/arm64\u001b[0m\r\n"]
[0.067, "o", "\u001b[1;32m  ✓ kubectl already installed -   gitVersion: v1.34.1\u001b[0m\r\n"]
[0.474, "o", "\u001b[1;32m  ✓ helm already installed - v4.1.1+g5caf004\u001b[0m\r\n"]
[0.797, "o", "\u001b[1;32m  ✓ clusteradm already installed - clusteradm\tversion\t:v1.3.1-0-g90bdc31\u001b[0m\r\n"]
[1.276, "o", "\u001b[1;32m  ✓ oc already installed - Client Version: 4.18.0-202504282205.p0.geb9bc9b.assembly.stream.el9-eb9bc9b\u001b[0m\r\n"]
[0.026, "o", "\r\n\u001b[1;36m========== 2. Python package - install the server into a local virtualenv ==========\u001b[0m\r\n"]
[1.690, "o", "\u001b[1;32m  ✓ installed ocm-mcp-server 0.2.2\u001b[0m\r\n"]
[0.036, "o", "\r\n\u001b[1;36m========== 3. Container engine - start Podman (Docker not required) ==========\u001b[0m\r\n"]
[0.172, "o", "\u001b[1;32m  ✓ podman is running (podman version 6.0.2)\u001b[0m\r\n"]
[0.474, "o", "\r\n\u001b[1;36m========== 4. Bootstrap - 1 hub + 2 spoke clusters, OCM, Kyverno, policies, demo app ==========\u001b[0m\r\n\u001b[0;90m  • this is the long step (a few minutes): creating clusters and joining them to the hub\u001b[0m\r\n"]
[281.185, "o", "  \r\n    # then register the server with your MCP client, e.g. for Claude Code:\r\n    #   see examples/claude-code.mcp.json\r\n  \r\n  Verify the fleet:\r\n    kubectl --context kind-hub get managedclusters\r\n"]
[0.058, "o", "\u001b[1;32m  ✓ fleet up: 2/2 spokes Available\u001b[0m\r\n"]
[0.050, "o", "  NAME       HUB ACCEPTED   MANAGED CLUSTER URLS                  JOINED   AVAILABLE   AGE\r\n  cluster1   true           https://cluster1-control-plane:6443   True     True        106s\r\n  cluster2   true           https://cluster2-control-plane:6443   True     True        79s\r\n"]
[0.034, "o", "\r\n\u001b[1;36m========== 4b. Enrich - install the policy add-on and enable ManifestWorkReplicaSet ==========\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m  • so add-on and policy tools have real data to return (best-effort)\u001b[0m\r\n"]
[12.116, "o", "\u001b[1;32m  ✓ enrichment: governance-policy-framework(enabled) ManifestWorkReplicaSet(enabled) acm+hypershift-fixtures\u001b[0m\r\n"]
[0.042, "o", "\r\n\u001b[1;36m========== 5. Exercising tools, prompts, the gated write flow, and a break-then-fix scenario ==========\u001b[0m\r\n"]
[0.451, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mPlacement + ClusterSetBinding\u001b[0m\r\n   \u001b[0;90mBind the 'global' cluster set into a namespace and add a Placement that selects every cluster - so the placement tools have a real decision to show.\u001b[0m\r\n   \u001b[0;90m$ kubectl apply Placement + ManagedClusterSetBinding\u001b[0m\r\n     binding=created, placement=created\r\n"]
[0.024, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mseed ManifestWork (gated)\u001b[0m\r\n   \u001b[0;90mDeploy a marker ManifestWork via propose+approve+apply so the work tools report on something real.\u001b[0m\r\n   \u001b[0;90m$ propose_manifestwork -> apply_manifestwork\u001b[0m\r\n     proposal_id=3d0f36d7b8254939bd70070e4c21ec0c\r\n     {\r\n       \"status\": \"applied\",\r\n       \"cluster\": \"cluster1\",\r\n       \"manifestwork\": \"e2e-seed\",\r\n       \"note\": \"Verify rollout with get_cluster_health / get_manifestwork. To undo, c\r\n"]
[0.004, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mManifestWorkReplicaSet\u001b[0m\r\n   \u001b[0;90mA single template fanned across every placement-selected cluster - so list_manifestworkreplicasets shows a rollout.\u001b[0m\r\n   \u001b[0;90m$ kubectl apply ManifestWorkReplicaSet\u001b[0m\r\n     result=created\r\n"]
[0.013, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mgovernance Policy\u001b[0m\r\n   \u001b[0;90mA sample inform Policy so the policy tools report on a real object.\u001b[0m\r\n   \u001b[0;90m$ kubectl apply Policy\u001b[0m\r\n     result=created\r\n"]
[6.008, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_clusters\u001b[0m\r\n   \u001b[0;90mThe fleet roster: every managed cluster, its version and health.\u001b[0m\r\n   \u001b[0;90m$ tool: list_clusters\u001b[0m\r\n     [\r\n       {\r\n         \"name\": \"cluster1\",\r\n         \"labels\": {},\r\n         \"available\": \"True\",\r\n         \"joined\": \"True\",\r\n         \"kubernetes_version\": \"v1.30.4\",\r\n         \"capacity\": {\r\n           \"cpu\": \"4\",\r\n"]
[0.000, "o", "           \"memory\": \"8099492Ki\"\r\n         }\r\n       },\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mget_cluster(cluster1)\u001b[0m\r\n   \u001b[0;90mZoom into one cluster: acceptance, taints, capacity, claims.\u001b[0m\r\n   \u001b[0;90m$ tool: get_cluster\u001b[0m\r\n     {\r\n       \"name\": \"cluster1\",\r\n       \"labels\": {},\r\n"]
[0.000, "o", "       \"hub_accepts_client\": true,\r\n       \"taints\": [],\r\n       \"conditions\": {\r\n         \"HubAcceptedManagedCluster\": \"True\",\r\n"]
[0.000, "o", "         \"ManagedClusterJoined\": \"True\",\r\n         \"ManagedClusterConditionAvailable\": \"True\",\r\n         \"ManagedClusterConditionClockSynced\": \"True\"\r\n       },\r\n       \"kubernetes_version\": \"v1.30.4\",\r\n"]
[0.003, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_sets\u001b[0m\r\n   \u001b[0;90mGroupings of clusters used for placement.\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_sets\u001b[0m\r\n     [\r\n       {\r\n         \"name\": \"default\",\r\n         \"selector_type\": \"ExclusiveClusterSetLabel\",\r\n         \"conditions\": {\r\n"]
[0.000, "o", "           \"ClusterSetEmpty\": \"True\"\r\n         },\r\n         \"members\": []\r\n       },\r\n"]
[0.000, "o", "       {\r\n"]
[0.000, "o", "         \"name\": \"global\",\r\n"]
[0.000, "o", "         \"selector_type\": \"LabelSelector\",\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_set_bindings\u001b[0m\r\n   \u001b[0;90mWhich cluster sets a namespace may schedule to.\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_set_bindings\u001b[0m\r\n     [\r\n       {\r\n         \"namespace\": \"default\",\r\n         \"name\": \"global\",\r\n"]
[0.000, "o", "         \"cluster_set\": \"global\",\r\n         \"conditions\": {\r\n           \"Bound\": \"True\"\r\n"]
[0.000, "o", "         }\r\n"]
[0.000, "o", "       }\r\n"]
[0.000, "o", "     ]\r\n"]
[0.002, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_claims\u001b[0m\r\n   \u001b[0;90mFacts each cluster self-reports (id, platform, version).\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_claims\u001b[0m\r\n     [\r\n       {\r\n         \"cluster\": \"cluster1\",\r\n         \"claims\": {}\r\n       },\r\n"]
[0.000, "o", "       {\r\n         \"cluster\": \"cluster2\",\r\n         \"claims\": {}\r\n       }\r\n"]
[0.000, "o", "     ]\r\n"]
[0.029, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mget_cluster_health(cluster1)\u001b[0m\r\n   \u001b[0;90mThe on-call view: unhealthy pods and degraded deployments.\u001b[0m\r\n   \u001b[0;90m$ tool: get_cluster_health\u001b[0m\r\n     {\r\n       \"cluster\": \"cluster1\",\r\n       \"hub_conditions\": {\r\n         \"HubAcceptedManagedCluster\": \"True\",\r\n"]
[0.000, "o", "         \"ManagedClusterJoined\": \"True\",\r\n         \"ManagedClusterConditionAvailable\": \"True\",\r\n         \"ManagedClusterConditionClockSynced\": \"True\"\r\n       },\r\n       \"unhealthy_pods\": [],\r\n       \"degraded_deployments\": [\r\n"]
[0.000, "o", "         {\r\n"]
[0.000, "o", "           \"namespace\": \"shop\",\r\n"]
[0.015, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mquery_events(cluster1)\u001b[0m\r\n   \u001b[0;90mRecent Kubernetes events - the 'why' behind failures.\u001b[0m\r\n   \u001b[0;90m$ tool: query_events\u001b[0m\r\n     [\r\n       {\r\n"]
[0.000, "o", "         \"namespace\": \"shop\",\r\n         \"type\": \"Normal\",\r\n         \"reason\": \"Pulled\",\r\n         \"object\": \"Pod/payments-5555cb47bc-j5m72\",\r\n"]
[0.000, "o", "         \"count\": 1,\r\n"]
[0.000, "o", "         \"message\": \"Successfully pulled image \\\"registry.k8s.io/e2e-test-images/agnhost:2.47\\\" in 198ms (14.281s including waiting). Image size: 50637101 bytes.\"\r\n       },\r\n       {\r\n         \"namespace\": \"shop\",\r\n         \"type\": \"Normal\",\r\n"]
[0.002, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_manifestworks(cluster1)\u001b[0m\r\n   \u001b[0;90mWhat the hub is currently delivering to this cluster.\u001b[0m\r\n   \u001b[0;90m$ tool: list_manifestworks\u001b[0m\r\n     [\r\n"]
[0.000, "o", "       {\r\n         \"name\": \"demo-mwrs6dcz8\",\r\n         \"applied\": \"True\",\r\n"]
[0.000, "o", "         \"available\": \"True\",\r\n"]
[0.000, "o", "         \"resources\": [\r\n           \"ConfigMap/e2e-seed (shop)\"\r\n         ]\r\n       },\r\n       {\r\n         \"name\": \"e2e-seed\",\r\n         \"applied\": \"True\",\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_manifestworkreplicasets\u001b[0m\r\n   \u001b[0;90mFleet-wide rollouts (a template fanned across clusters).\u001b[0m\r\n   \u001b[0;90m$ tool: list_manifestworkreplicasets\u001b[0m\r\n     [\r\n"]
[0.000, "o", "       {\r\n         \"namespace\": \"default\",\r\n"]
[0.000, "o", "         \"name\": \"demo-mwrs\",\r\n"]
[0.000, "o", "         \"summary\": {\r\n"]
[0.000, "o", "           \"applied\": 2,\r\n           \"available\": 2,\r\n           \"total\": 2\r\n         },\r\n         \"conditions\": {\r\n           \"PlacementVerified\": \"True\",\r\n           \"PlacementRolledOut\": \"False\",\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_management_addons\u001b[0m\r\n   \u001b[0;90mFleet-level add-on definitions.\u001b[0m\r\n"]
[0.000, "o", "   \u001b[0;90m$ tool: list_cluster_management_addons\u001b[0m\r\n"]
[0.001, "o", "     [\r\n       {\r\n         \"name\": \"config-policy-controller\",\r\n         \"install_strategy\": \"Manual\",\r\n         \"conditions\": {}\r\n       },\r\n"]
