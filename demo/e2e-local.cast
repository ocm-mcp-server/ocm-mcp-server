[0.000, "o", "         \"type\": \"Normal\",\r\n"]
[0.002, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_manifestworks(cluster1)\u001b[0m\r\n   \u001b[0;90mWhat the hub is currently delivering to this cluster.\u001b[0m\r\n   \u001b[0;90m$ tool: list_manifestworks\u001b[0m\r\n"]
