[0.000, "o", "         }\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_management_addons\u001b[0m\r\n   \u001b[0;90mFleet-level add-on definitions.\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_management_addons\u001b[0m\r\n     [\r\n"]
