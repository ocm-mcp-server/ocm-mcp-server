[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_pending_csrs\u001b[0m\r\n   \u001b[0;90mClusters waiting to be admitted to the hub.\u001b[0m\r\n   \u001b[0;90m$ tool: list_pending_csrs\u001b[0m\r\n     No pending CSRs - every cluster is already admitted (a healthy fleet).\r\n"]
