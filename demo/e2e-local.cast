[0.000, "o", "       {\r\n         \"namespace\": \"open-cluster-management-agent\",\r\n         \"type\": \"Normal\",\r\n         \"reason\": \"LeaderElection\",\r\n"]
[0.000, "o", "         \"object\": \"Lease/work-agent-lock\",\r\n"]
