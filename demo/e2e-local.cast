[0.619, "o", "\r\n\u001b[1;36m========== 1. Dependencies - install if missing, otherwise show the installed version ==========\u001b[0m\r\n"]
[0.013, "o", "\u001b[1;32m  ✓ podman already installed - podman version 6.0.2\u001b[0m\r\n"]
[0.048, "o", "\u001b[1;32m  ✓ kind already installed - kind v0.32.0 go1.26.3 darwin/arm64\u001b[0m\r\n"]
[0.158, "o", "\u001b[1;32m  ✓ kubectl already installed -   gitVersion: v1.34.1\u001b[0m\r\n"]
[0.430, "o", "\u001b[1;32m  ✓ helm already installed - v4.1.1+g5caf004\u001b[0m\r\n"]
[0.205, "o", "\u001b[1;32m  ✓ clusteradm already installed - clusteradm\tversion\t:v1.3.1-0-g90bdc31\u001b[0m\r\n"]
[1.221, "o", "\u001b[1;32m  ✓ oc already installed - Client Version: 4.18.0-202504282205.p0.geb9bc9b.assembly.stream.el9-eb9bc9b\u001b[0m\r\n"]
[0.037, "o", "\r\n\u001b[1;36m========== 2. Python package - install the server into a local virtualenv ==========\u001b[0m\r\n"]
[2.792, "o", "\u001b[1;32m  ✓ installed ocm-mcp-server 0.2.2\u001b[0m\r\n"]
[0.032, "o", "\r\n\u001b[1;36m========== 3. Container engine - start Podman (Docker not required) ==========\u001b[0m\r\n"]
[0.177, "o", "\u001b[1;32m  ✓ podman is running (podman version 6.0.2)\u001b[0m\r\n"]
[0.219, "o", "\r\n\u001b[1;36m========== 4. Bootstrap - 1 hub + 2 spoke clusters, OCM, Kyverno, policies, demo app ==========\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m  • this is the long step (a few minutes): creating clusters and joining them to the hub\u001b[0m\r\n"]
[508.615, "o", "  \r\n   Your managed cluster cluster2 has joined the Hub successfully. Visit https://open-cluster-management.io/scenarios or https://github.com/open-cluster-management-io/OCM/tree/main/solutions for next steps.\r\n  \r\n  \u001b[1;36m==> Installing Kyverno on the hub\u001b[0m\r\n  Error: resource Deployment/kyverno/kyverno-admission-controller not ready. status: InProgress, message: Available: 0/1\r\n  context deadline exceeded\r\n"]
[0.167, "o", "\u001b[1;32m  ✓ fleet up: 2/2 spokes Available\u001b[0m\r\n"]
[0.079, "o", "  NAME       HUB ACCEPTED   MANAGED CLUSTER URLS                  JOINED   AVAILABLE   AGE\r\n  cluster1   true           https://cluster1-control-plane:6443   True     True        18m\r\n  cluster2   true           https://cluster2-control-plane:6443   True     True        18m\r\n"]
[0.036, "o", "\r\n\u001b[1;36m========== 4b. Enrich - install the policy add-on and enable ManifestWorkReplicaSet ==========\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;90m  • so add-on and policy tools have real data to return (best-effort)\u001b[0m\r\n"]
[11.695, "o", "\u001b[1;32m  ✓ enrichment: governance-policy-framework(enabled) ManifestWorkReplicaSet(enabled) acm+hypershift-fixtures\u001b[0m\r\n"]
[0.032, "o", "\r\n\u001b[1;36m========== 5. Exercising tools, prompts, the gated write flow, and a break-then-fix scenario ==========\u001b[0m\r\n"]
[0.636, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mPlacement + ClusterSetBinding\u001b[0m\r\n   \u001b[0;90mBind the 'global' cluster set into a namespace and add a Placement that selects every cluster - so the placement tools have a real decision to show.\u001b[0m\r\n   \u001b[0;90m$ kubectl apply Placement + ManagedClusterSetBinding\u001b[0m\r\n     binding=created, placement=created\r\n"]
[0.012, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mseed ManifestWork (gated)\u001b[0m\r\n   \u001b[0;90mDeploy a marker ManifestWork via propose+approve+apply so the work tools report on something real.\u001b[0m\r\n   \u001b[0;90m$ propose_manifestwork -> apply_manifestwork\u001b[0m\r\n     proposal_id=5bd2c9a65fb9494aba0bbbcd88ba31d8\r\n     {\r\n       \"status\": \"applied\",\r\n       \"cluster\": \"cluster1\",\r\n"]
[0.000, "o", "       \"manifestwork\": \"e2e-seed\",\r\n       \"note\": \"Verify rollout with get_cluster_health / get_manifestwork. To undo, c\r\n"]
[0.002, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mManifestWorkReplicaSet\u001b[0m\r\n   \u001b[0;90mA single template fanned across every placement-selected cluster - so list_manifestworkreplicasets shows a rollout.\u001b[0m\r\n   \u001b[0;90m$ kubectl apply ManifestWorkReplicaSet\u001b[0m\r\n     result=created\r\n"]
[0.007, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mgovernance Policy\u001b[0m\r\n   \u001b[0;90mA sample inform Policy so the policy tools report on a real object.\u001b[0m\r\n   \u001b[0;90m$ kubectl apply Policy\u001b[0m\r\n     result=created\r\n"]
[6.006, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_clusters\u001b[0m\r\n   \u001b[0;90mThe fleet roster: every managed cluster, its version and health.\u001b[0m\r\n   \u001b[0;90m$ tool: list_clusters\u001b[0m\r\n     [\r\n       {\r\n         \"name\": \"cluster1\",\r\n         \"labels\": {\r\n           \"cluster.open-cluster-management.io/clusterset\": \"default\",\r\n           \"feature.open-cluster-management.io/addon-governance-policy-framework\": \"unreachable\"\r\n         },\r\n         \"available\": \"True\",\r\n         \"joined\": \"True\",\r\n"]
[0.000, "o", "         \"kubernetes_version\": \"v1.30.4\",\r\n         \"capacity\": {\r\n           \"cpu\": \"4\",\r\n"]
[0.003, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mget_cluster(cluster1)\u001b[0m\r\n   \u001b[0;90mZoom into one cluster: acceptance, taints, capacity, claims.\u001b[0m\r\n   \u001b[0;90m$ tool: get_cluster\u001b[0m\r\n"]
[0.000, "o", "     {\r\n       \"name\": \"cluster1\",\r\n       \"labels\": {\r\n"]
[0.000, "o", "         \"cluster.open-cluster-management.io/clusterset\": \"default\",\r\n"]
[0.000, "o", "         \"feature.open-cluster-management.io/addon-governance-policy-framework\": \"unreachable\"\r\n       },\r\n       \"hub_accepts_client\": true,\r\n       \"taints\": [],\r\n       \"conditions\": {\r\n         \"HubAcceptedManagedCluster\": \"True\",\r\n         \"ManagedClusterJoined\": \"True\",\r\n         \"ManagedClusterConditionAvailable\": \"True\",\r\n"]
[0.004, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_sets\u001b[0m\r\n   \u001b[0;90mGroupings of clusters used for placement.\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_sets\u001b[0m\r\n"]
[0.000, "o", "     [\r\n       {\r\n"]
[0.000, "o", "         \"name\": \"default\",\r\n"]
[0.000, "o", "         \"selector_type\": \"ExclusiveClusterSetLabel\",\r\n         \"conditions\": {\r\n           \"ClusterSetEmpty\": \"False\"\r\n         },\r\n         \"members\": [\r\n"]
[0.000, "o", "           \"cluster1\",\r\n           \"cluster2\"\r\n         ]\r\n"]
[0.000, "o", "       },\r\n"]
[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_set_bindings\u001b[0m\r\n   \u001b[0;90mWhich cluster sets a namespace may schedule to.\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_set_bindings\u001b[0m\r\n"]
[0.000, "o", "     [\r\n       {\r\n"]
[0.000, "o", "         \"namespace\": \"default\",\r\n"]
[0.000, "o", "         \"name\": \"global\",\r\n"]
[0.000, "o", "         \"cluster_set\": \"global\",\r\n"]
[0.000, "o", "         \"conditions\": {\r\n           \"Bound\": \"True\"\r\n         }\r\n       }\r\n     ]\r\n"]
[0.002, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mlist_cluster_claims\u001b[0m\r\n   \u001b[0;90mFacts each cluster self-reports (id, platform, version).\u001b[0m\r\n   \u001b[0;90m$ tool: list_cluster_claims\u001b[0m\r\n     [\r\n"]
[0.000, "o", "       {\r\n         \"cluster\": \"cluster1\",\r\n"]
[0.000, "o", "         \"claims\": {}\r\n"]
[0.001, "o", "       },\r\n       {\r\n         \"cluster\": \"cluster2\",\r\n         \"claims\": {}\r\n       }\r\n     ]\r\n"]
[0.035, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mget_cluster_health(cluster1)\u001b[0m\r\n   \u001b[0;90mThe on-call view: unhealthy pods and degraded deployments.\u001b[0m\r\n   \u001b[0;90m$ tool: get_cluster_health\u001b[0m\r\n     {\r\n       \"cluster\": \"cluster1\",\r\n       \"hub_conditions\": {\r\n         \"HubAcceptedManagedCluster\": \"True\",\r\n         \"ManagedClusterJoined\": \"True\",\r\n"]
[0.000, "o", "         \"ManagedClusterConditionAvailable\": \"True\",\r\n         \"ManagedClusterConditionClockSynced\": \"True\"\r\n       },\r\n       \"unhealthy_pods\": [],\r\n       \"degraded_deployments\": [],\r\n"]
[0.000, "o", "       \"spoke_view\": \"ok\"\r\n     }\r\n"]
