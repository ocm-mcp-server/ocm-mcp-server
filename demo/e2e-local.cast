[0.001, "o", "\r\n\u001b[1;32m[OK]\u001b[0m \u001b[1;36mget_addon_health\u001b[0m\r\n   \u001b[0;90mPer-cluster add-on health across the fleet.\u001b[0m\r\n   \u001b[0;90m$ tool: get_addon_health\u001b[0m\r\n"]
[0.000, "o", "     [\r\n       {\r\n         \"cluster\": \"cluster1\",\r\n         \"addon\": \"governance-policy-framework\",\r\n"]
