[0.000, "o", "         \"progressing\": \"False\"\r\n"]
[0.000, "o", "       },\r\n"]
[0.000, "o", "       {\r\n"]
[0.000, "o", "         \"cluster\": \"cluster2\",\r\n         \"addon\": \"governance-policy-framework\",\r\n         \"available\": \"Unknown\",\r\n"]
